# INCURSION Environment Configuration
# Default: Local SQLite database for immediate setup without requiring PostgreSQL server
DATABASE_URL="file:./dev.db"

# To switch to PostgreSQL (e.g. Supabase, Neon, or local Postgres):
# 1. Update DATABASE_URL="postgresql://postgres:password@localhost:5432/incursion?schema=public"
# 2. In prisma/schema.prisma, change provider = "postgresql"
# 3. Run: npx prisma db push

NEXTAUTH_SECRET="incursion-super-secret-campus-intelligence-key-2026"
NEXTAUTH_URL="http://localhost:3000"

NEXT_PUBLIC_APP_NAME="INCURSION - ACM Campus Intelligence"
